# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Drizzle
DATABASE_URL="file:./db.sqlite"

# OpenRouter
# Required. Statement parsing calls OpenRouter, so the app will not boot without
# it. Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
#
# Optional. Defaults to "z-ai/glm-5.3-flash".
#
# Model slug in "<author>/<slug>" form - see https://openrouter.ai/models. There
# is no region and no per-account entitlement to enable: a valid key plus a
# valid slug is the whole configuration.
#
# e.g. z-ai/glm-5.3-flash | z-ai/glm-5.3 | anthropic/claude-sonnet-5
OPENROUTER_MODEL_ID=
#
# Optional. Defaults to "deepinfra".
#
# The upstream provider OpenRouter is allowed to route to. Pinned, not
# preferred: the request sets allowFallbacks:false, so if this provider cannot
# serve the model the call fails rather than quietly routing somewhere else.
# Change it only deliberately - it decides which company processes statement
# data.
#
# To see which providers serve a model, and which support structured outputs:
#   curl -s https://openrouter.ai/api/v1/models/<author>/<slug>/endpoints
OPENROUTER_PROVIDER=

# Verify the whole path without deploying:
#   pnpm llm:smoke
