# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Drizzle
DATABASE_URL="file:./db.sqlite"

# Bedrock
# Optional. Defaults to "eu-west-1".
#
# Region for the Claude-in-Bedrock Messages API endpoint
# (bedrock-mantle.{BEDROCK_REGION}.api.aws). Separate from AWS_REGION, which
# selects the region the whole stack deploys into - only a subset of AWS regions
# serve this endpoint, and eu-west-2 (London) is NOT one of them: every model ID
# returns 404 there. eu-west-1 (Ireland) is the nearest region that works and
# keeps statement data in the EU. Verify with: node scripts/bedrock-probe.mjs
BEDROCK_REGION=
#
# Optional. Defaults to "anthropic.claude-sonnet-5".
#
# Model IDs on this endpoint take an "anthropic." provider prefix, no version
# suffix, and no geo prefix - "eu." / "global." are a bedrock-runtime
# inference-profile convention that resolves to nothing here.
#
# e.g. anthropic.claude-sonnet-5 | anthropic.claude-opus-5 | anthropic.claude-haiku-4-5
#
# Whichever model is used must be enabled for the AWS account under
# Bedrock > Model access, in BEDROCK_REGION.
BEDROCK_MODEL_ID=
