# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Drizzle
DATABASE_URL="file:./db.sqlite"

# Bedrock
# Optional. Defaults to "anthropic.claude-sonnet-5".
#
# Statement parsing uses the Claude-in-Bedrock Messages API endpoint, so model IDs
# take an "anthropic." provider prefix, no version suffix, and no geo prefix -
# "eu." / "global." are a bedrock-runtime inference-profile convention that does
# not apply here. Region, and so data residency, comes from AWS_REGION: the
# request goes to bedrock-mantle.{AWS_REGION}.api.aws and is kept in that region.
#
# e.g. anthropic.claude-sonnet-5 | anthropic.claude-opus-5 | anthropic.claude-haiku-4-5
#
# Whichever model is used must be enabled for the AWS account under
# Bedrock > Model access.
BEDROCK_MODEL_ID=
